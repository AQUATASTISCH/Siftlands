{
	"schemaVersion": 1,
	"id": "siftlands",
	"version": "${version}",
	"name": "Siftlands",
	"description": "Siftlands is a Fabric mod created for the Siftlands.de server, but usable on any Fabric server.",
	"authors": [
		"AQUATASTISCH"
	],
	"contact": {
		"homepage": "https://siftlands.de/",
		"sources": "https://github.com/AQUATASTISCH/Siftlands/",
		"issues": "https://github.com/AQUATASTISCH/Siftlands/issues"
	},
	"license": "AGPL-3.0-only",
	"icon": "assets/siftlands/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.siftlands.Siftlands"
		],
		"client": [
			"de.siftlands.client.SiftlandsClient"
		],
		"fabric-datagen": [
			"de.siftlands.client.SiftlandsDataGenerator"
		]
	},
	"mixins": [
		"siftlands.mixins.json",
		{
			"config": "siftlands.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}